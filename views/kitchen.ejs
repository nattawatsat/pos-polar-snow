<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Back</title>
    <link 
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
  rel="stylesheet">
  <style>
    body{
        font-size: 24px;;
    }

    button:focus, button:active,
    a:focus, a:active,
    .btn:focus, .btn:active {
    outline: none ;
    box-shadow: none ;
    }

    .btn:focus, .btn:active {
        outline: none ;
        box-shadow: none ;
    }
    td {
    vertical-align: top;
    word-wrap: break-word;
    white-space: normal; 
    max-width: 300px; 
  }
  small.note-text {
    display: block; 
    white-space: normal; 
    word-wrap: break-word; 
    max-width: 300px; 
  }

  </style>
</head>
<body>
    <table class="table">
  <thead>
    <th>คิว</th>
    <th>เลขโต๊ะ</th>
    <th>อาหาร</th>
    <th>topping / หมายเหตุ</th>
    <th>สถานะ</th>
    <th>อัปเดตสถานะ</th>
  </thead>
  <% data.forEach((item, index) => { %>
    <tr>
      <td><%= index + 1 %></td>
      <td><%= item.table_id %></td>
      <td><%= item.food %> </td>
      <td>
        <% if (item.toppings.length > 0) { %>
          <%= item.toppings.join(", ") %>
        <% } %>
        <% if (item.note) { %>
          <br><small>หมายเหตุ: <%= item.note %></small>
        <% } %>
      </td>
      <td><%= item.status %></td>
      <td>
        <a href="/update-status?order_id=<%= item.order_id %>" class="btn btn-success">อัปเดต</a>
        <a href="/delete-order?order_id=<%= item.order_id %>" class="btn btn-danger">ลบ</a>
      </td>
    </tr>
  <% }); %>
</table>

<script>
  setInterval(() => {
    location.reload();
  }, 5000); // รีทุก 5 วินาที
</script>
</body>
</html>