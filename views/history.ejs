<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ประวัติการสั่งสินค้า</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #fff8f4;
      font-family: "Prompt", sans-serif;
    }
    .history-container {
      max-width: 900px;
      margin: auto;
      background: #FEFAF3;  
      border: 2px solid #d9b8a3;
      border-radius: 10px;
      padding: 20px;
    }
    .logo {
      text-align: center;
      margin-bottom: 20px;
    }
    .logo img {
      max-height: 100px;
    }
    .order-card {
      background: #ffe9e9;
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 15px;
    }
    .order-title {
      font-weight: bold;
      margin-bottom: 8px;
    }
    .order-items {
      margin-left: 15px;
    }
    .btn-group {
      text-align: center;
      margin-top: 20px;
    }
    .btn-pink {
      background-color: #f6b6c3;
      border: none;
      color: #fff;
      font-size: 18px;
      padding: 8px 20px;
      border-radius: 8px;
      margin: 0 10px;
    }
    .btn-pink:hover {
      background-color: #e49aa9;
      color: #fff;
    }
    .note-text {
    display: block;
    white-space: normal;     
    word-wrap: break-word;  
    max-width: 300px;       
  }
  </style>
</head>
<body>
  <div class="history-container">
    <div class="logo">
      <img src="/img/logo.jfif" alt="Polar Snow Logo" style="border-radius: 5px;">
    </div>

    <% if (orders.length === 0) { %>
      <p class="text-center">ยังไม่มีประวัติการสั่งซื้อ</p>
    <% } else { %>
      <% orders.forEach((order, index) => { %>
        <div class="order-card">
          <div class="order-title"><%= index + 1 %>. ชื่อเมนู</div>
          <div class="order-items">
            <% order.items.forEach(item => { %>
              • <%= item.food_name %> <br>
              <% if (item.toppings.length > 0) { %>
                <small>- <%= item.toppings.join(", ") %></small><br>
              <% } %>
              <% if (item.note) { %>
                <small class="note-text">- หมายเหตุ: <%= item.note %></small><br>
              <% } %>
            <% }) %>
          </div>
        </div>
      <% }) %>
    <% } %>

    <div class="btn-group">
      <a href="/menu/<%= table_id %>" class="btn btn-pink">สั่งสินค้าเพิ่ม</a>
      <a href="/chose-pay/<%= table_id %>" class="btn btn-pink">ชำระเงิน</a>
    </div>
  </div>
</body>
</html>
