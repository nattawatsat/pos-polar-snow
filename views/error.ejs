<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>เกิดข้อขัดข้อง — Polar Snow</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="container text-center py-5">
<img src="/img/logo.jfif" alt="Polar Snow" style="height:90px;border-radius:16px;">
<h3 class="mt-3">ขออภัย เกิดข้อขัดข้องชั่วคราว</h3>
<p class="text-muted"><%= typeof table_id !== 'undefined' && table_id ? 'โต๊ะ ' + table_id + ' · ' : '' %>กรุณาแตะปุ่มด้านล่างเพื่อกลับไปหน้าเมนู</p>
<% if (typeof table_id !== 'undefined' && table_id) { %>
<a href="/menu/<%= table_id %>" class="btn btn-pink btn-lg px-5">กลับไปหน้าเมนู</a>
<% } else { %>
<a href="/tables" class="btn btn-pink btn-lg px-5">เลือกโต๊ะ</a>
<% } %>
<p class="mt-3"><button class="btn btn-link" onclick="location.reload()">ลองใหม่</button></p>
</div>
</body>
</html>
