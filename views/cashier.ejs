<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cashier</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9ff;
      font-family: "Prompt", sans-serif;
    }
    .title {
      text-align: center;
      font-size: 42px;
      font-weight: bold;
      margin: 30px 0;
      color: #6f7cff;
    }
    .grid-container {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
      padding: 20px;
      max-width: 1000px;
      margin: auto;
    }
    .table-card {
      background-color: #6f7cff;
      color: white;
      font-weight: bold;
      font-size: 22px;
      text-align: center;
      border-radius: 15px;
      text-decoration: none;
      box-shadow: 0px 6px 12px rgba(0,0,0,0.15);
      transition: transform 0.2s ease, background-color 0.2s ease;

      aspect-ratio: 1 / 1;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .table-card:hover {
      transform: translateY(-5px);
      background-color: #5a66d1;
    }
  </style>
</head>
<body>
  <div class="title">กรุณาเลือกโต๊ะ</div>

  <div class="grid-container">
    <% data.forEach((item)=>{ %>
      <a href="/cashier-table/<%=item.table_id%>" class="table-card">
        โต๊ะ <%=item.table_id%>
      </a>
    <% }); %>
  </div>
</body>
</html>
