<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Polar Snow" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/img/logo.jfif" />
    <title>menu</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <!-- Navbar ด้านบน -->
    <nav class="top-nav">
      <div class="nav-left">
        <img src="/img/logo.jfif" alt="Polar Snow Logo">
        <p class="nav-title">Polar Snow</p>
      </div>
    </nav>

    <div class="container-fluid">
      <div class="row">
        <!-- เมนู nav ด้านซ้าย -->
        <div class="col-md-2 left-nav-sticky">
          <ul class="nav flex-column mb-3">
            <% for (let cat in categories) { %>
              <li class="nav-item">
                <a class="nav-link" href="#<%= cat %>"><%= cat %></a>
              </li>
            <% } %>
          </ul>
        </div>

        <!-- เมนูอาหาร -->
        <div class="col-md-7">
          <% for (let cat in categories) { %>
            <center>
              <h4 id="<%= cat %>" class="category-title mt-4 mb-3"><%= cat %></h4>
            </center>
            <div class="row">
              <% categories[cat].forEach(item => { %>
                <div class="col-md-4 mb-3">
                  <div class="card p-2">
                    <img src="<%= item.food_pic %>" alt="<%= item.food_name %>">
                    <h5><%= item.food_name %></h5>
                    <p><%= item.food_price %> บาท</p>
                    <a href="/customize/<%= item.food_id %>/<%= table_id %>" class="btn btn-pink">เพิ่มลงตะกร้า</a>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Sidebar ตะกร้า -->
        <div class="col-md-3">
          <div class="sidebar sticky-sidebar">
            <h5>ตะกร้าสินค้าของคุณ</h5>
              <ul>
              <% if (cart && cart.length > 0) { %>
                <% cart.forEach(item => { %>
                  <li>
                    <%= item.food_name %>
                    <% if (item.toppings.length > 0) { %>
                      <small>(
                        <%= item.toppings.map(tp => tp.name + " x" + tp.qty).join(", ") %>
                      )</small>
                    <% } %>
                  </li>
                <% }) %>
              <% } else { %>
                <li>ยังไม่มีสินค้า</li>
              <% } %>
            </ul>

            <a href="/cart/<%= table_id %>" class="btn btn-primary w-100 mb-2">เข้าดูตะกร้า</a>
            <form action="/order/<%= table_id %>" method="POST">
              <button type="submit" class="btn btn-green w-100 mb-2">สั่งสินค้า</button>
            </form>
            <a href="/history/<%= table_id %>" class="btn btn-orange w-100 mb-2">ประวัติการสั่งสินค้า</a>
            <a href="/chose-pay/<%= table_id %>" class="btn btn-pink" w-100 mb-2">เลือกวิธีชำระเงิน</a>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
